# image_factory 环境变量配置
# 复制此文件为 .env 并填入实际的 API 密钥

# API 安全开关（必须设置为 1 才能启用 API 调用）
IMAGE_FACTORY_API_ENABLED=0

# OpenAI 官方 API 密钥
# OPENAI_API_KEY=your-openai-api-key-here

# 自建 DALL-E 格式代理配置
# IMAGE_FACTORY_API_BASE_URL=https://your-proxy-url.example.com
# IMAGE_FACTORY_API_KEY=your-proxy-api-key-here

# 多 key 并发配置（可选）
# IMAGE_FACTORY_API_KEY_0=your-first-api-key
# IMAGE_FACTORY_API_KEY_1=your-second-api-key
